<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

<PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>portable</DebugType> 
    <DebugSymbols>true</DebugSymbols>
    
    <TieredCompilation>false</TieredCompilation> 
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- 1. The standard reference to the TECS engine -->
    <ProjectReference Include="..\..\src\TECS\TECS.csproj" />

    <!-- 2. The analyzer reference for the Source Generator -->
    <ProjectReference Include="..\..\src\Generator\Generator.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
</ItemGroup>

<PropertyGroup>
    <!--Tells Roslyn to save generated files to disk -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    
    <!-- Specifies the folder path where files will be saved -->
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevents duplicate symbol errors (CS0101) by telling 
         the compiler NOT to compile the files sitting on disk, 
         since the generator will inject them in-memory during build -->
    <Compile Remove="Generated\**" />
  </ItemGroup>

</Project>
